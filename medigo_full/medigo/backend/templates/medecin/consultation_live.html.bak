var selectedSymptomes = new Map(); // nom -> {intensite, evolution}
var selectedMaladies = new Set();
var selectedAllergies = new Set();
var selectedChroniques = new Set();

function initLists() {
    renderSymptomes(SYMPTOMES);
    renderMaladies(MALADIES);
    renderAllergies(ALLERGIES);
    renderChroniques(CHRONIQUES);
}

// ===== ALLERGIES =====
function renderAllergies(list) {
    var c = document.getElementById('allergies-list');
    c.innerHTML = '';
    list.forEach(function(a) {
        var div = document.createElement('div');
        div.className = 'symptom-item' + (selectedAllergies.has(a) ? ' checked' : '');
        div.innerHTML = '<input type="checkbox" ' + (selectedAllergies.has(a) ? 'checked' : '') + '><span>' + a + '</span>';
        div.onclick = function() {
            if (selectedAllergies.has(a)) { selectedAllergies.delete(a); div.classList.remove('checked'); div.querySelector('input').checked=false; }
            else { selectedAllergies.add(a); div.classList.add('checked'); div.querySelector('input').checked=true; }
            renderSelectedAllergies();
        };
        c.appendChild(div);
    });
}
function filterAllergies(q) {
    var filtered = q ? ALLERGIES.filter(function(a) { return a.toLowerCase().includes(q.toLowerCase()); }) : ALLERGIES;
    renderAllergies(filtered);
    var box = document.getElementById('add-allergie-box');
    box.style.display = (q && filtered.length === 0) ? 'block' : 'none';
    if (q && filtered.length === 0) document.getElementById('custom-allergie-input').value = q;
}
function ajouterAllergieCustom() {
    var val = document.getElementById('custom-allergie-input').value.trim();
    if (!val) return;
    if (!ALLERGIES.includes(val)) ALLERGIES.push(val);
    selectedAllergies.add(val);
    document.getElementById('allergie-search').value = '';
    document.getElementById('add-allergie-box').style.display = 'none';
    renderAllergies(ALLERGIES);
    renderSelectedAllergies();
}
function renderSelectedAllergies() {
    var c = document.getElementById('selected-allergies');
    c.innerHTML = Array.from(selectedAllergies).map(function(a) {
        return '<span style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.2rem 0.5rem;background:#ffebee;color:#c62828;border-radius:20px;font-size:0.75rem;font-weight:600;">' + a + ' <span style="cursor:pointer;opacity:0.6;" onclick="selectedAllergies.delete(\'' + a.replace(/'/g,"\\'") + '\');renderSelectedAllergies();renderAllergies(ALLERGIES);">×</span></span>';
    }).join('');
}

