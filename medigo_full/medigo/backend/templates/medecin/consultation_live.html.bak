        div.className = 'symptom-item' + (selectedChroniques.has(ch) ? ' checked' : '');
        div.innerHTML = '<input type="checkbox" ' + (selectedChroniques.has(ch) ? 'checked' : '') + '><span>' + ch + '</span>';
        div.onclick = function() {
            if (selectedChroniques.has(ch)) { selectedChroniques.delete(ch); div.classList.remove('checked'); div.querySelector('input').checked=false; }
            else { selectedChroniques.add(ch); div.classList.add('checked'); div.querySelector('input').checked=true; }
            renderSelectedChroniques();
        };
        c.appendChild(div);
    });
}
function filterChroniques(q) {
    var filtered = q ? CHRONIQUES.filter(function(c) { return c.toLowerCase().includes(q.toLowerCase()); }) : CHRONIQUES;
    renderChroniques(filtered);
}
function renderSelectedChroniques() {
