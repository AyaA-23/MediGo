// ===== TABS =====
function showTab(tab) {
    var tabs = ['patient','symptomes','maladies','mesures'];
    document.querySelectorAll('.sidebar-tab').forEach(function(t, i) {
        t.classList.toggle('active', tabs[i] === tab);
    });
    document.querySelectorAll('.sidebar-panel').forEach(function(p) { p.classList.remove('active'); });
    document.getElementById('panel-' + tab).classList.add('active');
}

// ===== IMC =====
function calcIMC() {
    var p = parseFloat(document.getElementById('poids').value);
    var t = parseFloat(document.getElementById('taille').value);
    if (p && t && t > 0) {
        var imc = (p / Math.pow(t / 100, 2)).toFixed(1);
        document.getElementById('imc-value').textContent = imc;
        document.getElementById('imc-display').style.display = 'block';
    }
}

// ===== TENSION INTERPRETATION =====
function interpTension() {
    var sys = parseInt(document.getElementById('tension-sys').value);
    var dia = parseInt(document.getElementById('tension-dia').value);
    var el = document.getElementById('tension-interp');
    if (!sys || !dia) { el.style.display = 'none'; return; }
    var label = '', color = '', bg = '';
    if (sys < 90 || dia < 60) { label = 'Hypotension'; color = '#1565c0'; bg = '#e3f2fd'; }
    else if (sys <= 120 && dia <= 80) { label = 'Normale'; color = '#2e7d32'; bg = '#e8f5e9'; }
    else if (sys <= 139 || dia <= 89) { label = 'Pré-hypertension'; color = '#e65100'; bg = '#fff3e0'; }
    else { label = 'Hypertension'; color = '#c62828'; bg = '#ffebee'; }
    el.textContent = label + ' (' + sys + '/' + dia + ')';
    el.style.color = color; el.style.background = bg; el.style.display = 'block';
}

// ===== GLYCEMIE INTERPRETATION =====
function interpGlycemie() {
    var g = parseFloat(document.getElementById('glycemie').value);
    var el = document.getElementById('glycemie-interp');
    if (!g) { el.style.display = 'none'; return; }
    var label = '', color = '', bg = '';
    // Glycémie à jeun en g/L
    if (g < 0.70) { label = 'Hypoglycémie'; color = '#1565c0'; bg = '#e3f2fd'; }
    else if (g <= 1.10) { label = 'Normal'; color = '#2e7d32'; bg = '#e8f5e9'; }
    else if (g <= 1.26) { label = 'Prédiabète'; color = '#e65100'; bg = '#fff3e0'; }
    else { label = 'Diabète'; color = '#c62828'; bg = '#ffebee'; }
    el.textContent = label + ' (' + g.toFixed(2) + ' g/L)';
    el.style.color = color; el.style.background = bg; el.style.display = 'block';
}

// ===== SAUVEGARDES =====
function sauvegarderPatient() {
    var gs = document.getElementById('groupe-sanguin').value;
    // Sauvegarder infos patient
    fetch('/api/consultation/infos-patient/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({patient_id: patientId, groupe_sanguin: gs})
    });
    // Sauvegarder allergies
    fetch('/api/consultation/allergies/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({consultation_id: consultationId, allergies: Array.from(selectedAllergies)})
    });
    // Sauvegarder info clinique
    var enceinte = null;
    var enceinteOui = document.getElementById('enceinte-oui');
    if (enceinteOui) enceinte = enceinteOui.checked;
    fetch('/api/consultation/info-clinique/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({
            consultation_id: consultationId,
            tabac: document.getElementById('tabac').value,
            alcool: document.getElementById('alcool').value,
            activite_physique: document.getElementById('activite-physique').value,
            enceinte: enceinte,
            maladies_chroniques: selectedChroniques.size > 0,
        })
    });
    // Sauvegarder maladies chroniques comme PatientMaladie
    if (selectedChroniques.size > 0) {
        var chronList = Array.from(selectedChroniques).map(function(c) { return {nom: c, est_chronique: true}; });
        fetch('/api/consultation/maladies/', {
            method: 'POST',
            headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
            body: JSON.stringify({consultation_id: consultationId, maladies: chronList})
        });
    }
    var msg = document.getElementById('patient-saved-msg');
    msg.innerHTML = '<i class="fa-solid fa-check"></i> Informations sauvegardées';
    msg.style.color = '#43a047'; msg.style.background = '#e8f5e9'; msg.style.display = 'block';
    setTimeout(function() { msg.style.display = 'none'; }, 3000);
}

function sauvegarderMesures() {
    fetch('/api/consultation/mesures/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({
            consultation_id: consultationId,
            poids_kg: document.getElementById('poids').value || null,
            taille_cm: document.getElementById('taille').value || null,
            tension_sys: document.getElementById('tension-sys').value || null,
            tension_dia: document.getElementById('tension-dia').value || null,
            glycemie: document.getElementById('glycemie').value || null,
        })
    }).then(function() {
        var msg = document.getElementById('mesures-saved-msg2');
        msg.innerHTML = '<i class="fa-solid fa-check"></i> Mesures sauvegardées';
        msg.style.color = '#43a047'; msg.style.background = '#e8f5e9'; msg.style.display = 'block';
        setTimeout(function() { msg.style.display = 'none'; }, 3000);
    });
}

function sauvegarderSymptomes() {
    var count = selectedSymptomes.size;
    var symptList = [];
    selectedSymptomes.forEach(function(data, nom) {
        symptList.push({nom: nom, intensite: data.intensite, evolution: data.evolution});
    });
    fetch('/api/consultation/symptomes/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({consultation_id: consultationId, symptomes: symptList})
    }).then(function() {
        var msg = document.getElementById('symptomes-saved-msg');
        msg.innerHTML = '<i class="fa-solid fa-check"></i> ' + count + ' symptôme(s) sauvegardé(s)';
        msg.style.display = 'block';
        setTimeout(function() { msg.style.display = 'none'; }, 3000);
    });
}

function sauvegarderMaladies() {
    var count = selectedMaladies.size;
    var malList = Array.from(selectedMaladies).map(function(m) { return {nom: m, est_chronique: false}; });
    fetch('/api/consultation/maladies/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({consultation_id: consultationId, maladies: malList})
    }).then(function() {
        var msg = document.getElementById('maladies-saved-msg');
        msg.innerHTML = '<i class="fa-solid fa-check"></i> ' + count + ' maladie(s) sauvegardée(s)';
        msg.style.display = 'block';
        setTimeout(function() { msg.style.display = 'none'; }, 3000);
    });
}

function enregistrerMesures() {
    var spo2 = document.getElementById('spo2').textContent;
    var fc = document.getElementById('fc').textContent;
    var temp = document.getElementById('temp').textContent;
    if (spo2 === 'OFF' && fc === 'OFF' && temp === 'OFF') {
        var msg = document.getElementById('mesures-saved-msg');
        msg.innerHTML = '<i class="fa-solid fa-exclamation-triangle"></i> Capteurs désactivés';
        msg.style.color = 'var(--orange)'; msg.style.background = 'rgba(251,140,0,0.1)';
        msg.style.display = 'block';
        setTimeout(function() { msg.style.display = 'none'; }, 2000);
        return;
    }
    if (spo2 === '--' && fc === '--' && temp === '--') {
        var msg = document.getElementById('mesures-saved-msg');
        msg.innerHTML = '<i class="fa-solid fa-exclamation-triangle"></i> Aucune mesure';
        msg.style.color = 'var(--orange)'; msg.style.background = 'rgba(251,140,0,0.1)';
        msg.style.display = 'block';
        setTimeout(function() { msg.style.display = 'none'; }, 2000);
        return;
    }
    fetch('/api/sensors/enregistrer-mesures/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({
            consultation_id: consultationId,
            spo2: (spo2 !== '--' && spo2 !== 'OFF') ? parseFloat(spo2) : null,
            frequence_cardiaque: (fc !== '--' && fc !== 'OFF') ? parseFloat(fc) : null,
            temperature: (temp !== '--' && temp !== 'OFF') ? parseFloat(temp) : null
        })
    }).then(function(r) { return r.json(); })
    .then(function() {
        document.getElementById('saved-spo2').textContent = spo2;
        document.getElementById('saved-fc').textContent = fc;
        document.getElementById('saved-temp').textContent = temp;
        document.getElementById('mesures-enregistrees').style.display = 'block';
        var msg = document.getElementById('mesures-saved-msg');
        msg.innerHTML = '<i class="fa-solid fa-check"></i> Mesures enregistrées';
        msg.style.color = 'var(--green)'; msg.style.background = 'rgba(67,160,71,0.1)';
        msg.style.display = 'block';
        setTimeout(function() { msg.style.display = 'none'; }, 3000);
    });
}

function notifierPatientPreparation(e, url, avecOrdonnance) {
    e.preventDefault();
    fetch('/api/consultation/notifier-fin/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({consultation_id: consultationId, avec_ordonnance: avecOrdonnance})
    }).finally(function() {
        window.location.href = url;
    });
}

var chatOpen = false;
var unreadMessages = 0;

function toggleChatPopup() {
    chatOpen = !chatOpen;
    document.getElementById('chat-popup').classList.toggle('show', chatOpen);
    if (chatOpen) {
        unreadMessages = 0;
        document.getElementById('chat-badge').style.display = 'none';
        document.getElementById('chat-input').focus();
    }
}

function notifyChatMessage() {
    if (!chatOpen) {
        unreadMessages++;
        var badge = document.getElementById('chat-badge');
        badge.textContent = unreadMessages;
        badge.style.display = 'flex';
    }
}

// Fermer chat quand on clique ailleurs
document.addEventListener('click', function(e) {
    if (chatOpen && !e.target.closest('#chat-popup') && !e.target.closest('#chat-fab')) {
        chatOpen = false;
        document.getElementById('chat-popup').classList.remove('show');
    }
});

// ===== AI RULE-BASED SUGGESTIONS =====
// ===== AI REFERENTIEL =====
var REFERENTIEL = null;
var COMBO_RULES = [];
var RED_FLAGS = [];

fetch('/static/data/referentiel.json')
    .then(function(r) { return r.json(); })
    .then(function(data) {
        REFERENTIEL = data.symptoms || {};
        COMBO_RULES = data.combo_rules || [];
        RED_FLAGS = data.red_flags || [];
        // Mettre à jour la liste SYMPTOMES avec ceux du référentiel
        Object.keys(REFERENTIEL).forEach(function(s) {
            if (!SYMPTOMES.includes(s)) SYMPTOMES.push(s);
        });
        renderSymptomes(SYMPTOMES);
        console.log('Référentiel chargé:', Object.keys(REFERENTIEL).length, 'symptômes,', COMBO_RULES.length, 'combos');
    })
    .catch(function(e) { console.log('Erreur chargement référentiel:', e); });

function updateAISuggestions() {
    var container = document.getElementById('ai-suggestions');
    if (selectedSymptomes.size === 0) {
        container.innerHTML = '<div class="ai-empty"><i class="fa-solid fa-robot"></i>Sélectionnez des symptômes pour voir les suggestions</div>';
        return;
    }
    if (!REFERENTIEL) {
        container.innerHTML = '<div class="ai-empty"><i class="fa-solid fa-spinner fa-spin"></i>Chargement du référentiel...</div>';
        return;
    }

    var allMaladies = {};
    var allQuestions = [];
    var seenQuestions = {};
    var redFlagHints = [];
    var seenHints = {};
    var selectedList = [];

    selectedSymptomes.forEach(function(data, symptom) {
        selectedList.push(symptom);
        var rule = REFERENTIEL[symptom];
        if (rule) {
            // Ajouter diagnostics
            if (rule.diagnoses) {
                rule.diagnoses.forEach(function(d) {
                    if (allMaladies[d.name]) {
                        allMaladies[d.name] = Math.min(95, allMaladies[d.name] + Math.round(d.weight * 0.6));
                    } else {
                        allMaladies[d.name] = d.weight;
                    }
                });
            }
            // Ajouter questions
            if (rule.questions) {
                rule.questions.forEach(function(q) {
                    if (!seenQuestions[q]) { allQuestions.push(q); seenQuestions[q] = true; }
                });
            }
            // Red flag hints
            if (rule.red_flag_hint && !seenHints[rule.red_flag_hint]) {
                redFlagHints.push(rule.red_flag_hint);
                seenHints[rule.red_flag_hint] = true;
            }
        }
    });

    // Appliquer combo rules
    COMBO_RULES.forEach(function(combo) {
        var match = combo.symptoms.every(function(s) { return selectedList.includes(s); });
        if (match) {
            if (allMaladies[combo.disease]) {
                allMaladies[combo.disease] += combo.score_bonus;
            } else {
                allMaladies[combo.disease] = combo.score_bonus;
            }
            allMaladies[combo.disease] = Math.min(95, allMaladies[combo.disease]);
        }
    });

    // Trier par score
    var sortedMaladies = Object.entries(allMaladies).sort(function(a, b) { return b[1] - a[1]; }).slice(0, 8);

    // Vérifier red flags dans les symptômes sélectionnés
    var activeRedFlags = [];
    RED_FLAGS.forEach(function(rf) {
        selectedList.forEach(function(s) {
            if (s.toLowerCase().includes(rf.toLowerCase()) || rf.toLowerCase().includes(s.toLowerCase())) {
                activeRedFlags.push(rf);
            }
        });
    });

    // Construire HTML
    var html = '';

    // Red flags en premier
    if (activeRedFlags.length > 0 || redFlagHints.length > 0) {
        html += '<div style="background:#ffebee;border:1px solid #e53935;border-radius:8px;padding:0.6rem;margin-bottom:0.5rem;">';
        html += '<div style="font-size:0.72rem;font-weight:800;color:#c62828;text-transform:uppercase;margin-bottom:0.3rem;"><i class="fa-solid fa-triangle-exclamation"></i> Signaux d\'alerte</div>';
        redFlagHints.forEach(function(h) {
            html += '<div style="font-size:0.78rem;color:#c62828;padding:0.2rem 0;">' + h + '</div>';
        });
        html += '</div>';
    }

    // Orientations diagnostiques
    if (sortedMaladies.length > 0) {
        html += '<div class="ai-box"><div class="ai-box-title"><i class="fa-solid fa-chart-pie"></i> Orientations diagnostiques</div>';
        sortedMaladies.forEach(function(m) {
            var pct = Math.min(95, Math.round(m[1]));
            var cls = pct >= 30 ? 'high' : pct >= 15 ? 'medium' : 'low';
            // Chercher si c'est un combo match
            var isCombo = false;
            COMBO_RULES.forEach(function(c) {
                if (c.disease === m[0] && c.symptoms.every(function(s) { return selectedList.includes(s); })) isCombo = true;
            });
            html += '<div class="ai-disease"><span class="ai-disease-name">' + m[0] + (isCombo ? ' <i class="fa-solid fa-link" style="font-size:0.6rem;color:#5c6bc0;" title="Combinaison de symptômes"></i>' : '') + '</span><span class="ai-confidence ' + cls + '">' + pct + '%</span></div>';
        });
        html += '</div>';
    }

    // Questions à poser
    if (allQuestions.length > 0) {
        html += '<div class="ai-box"><div class="ai-box-title"><i class="fa-solid fa-circle-question"></i> Questions à poser</div>';
        allQuestions.slice(0, 10).forEach(function(q) {
            html += '<div class="ai-question"><i class="fa-solid fa-chevron-right"></i><span>' + q + '</span></div>';
        });
        html += '</div>';
    }

    html += '<div class="ai-disclaimer"><i class="fa-solid fa-triangle-exclamation"></i> ' + (REFERENTIEL ? 'Estimation indicative — ne remplace pas le jugement clinique' : '') + '</div>';

    container.innerHTML = html;
}

var chatOpen = false;
var unreadMessages = 0;

function toggleChatPopup() {
    chatOpen = !chatOpen;
    document.getElementById('chat-popup').classList.toggle('show', chatOpen);
    if (chatOpen) {
        unreadMessages = 0;
        document.getElementById('chat-badge').style.display = 'none';
        document.getElementById('chat-input').focus();
    }
}

function notifyChatMessage() {
    if (!chatOpen) {
        unreadMessages++;
        var badge = document.getElementById('chat-badge');
        badge.textContent = unreadMessages;
        badge.style.display = 'flex';
    }
}

// Fermer chat quand on clique ailleurs
document.addEventListener('click', function(e) {
    if (chatOpen && !e.target.closest('#chat-popup') && !e.target.closest('#chat-fab')) {
        chatOpen = false;
        document.getElementById('chat-popup').classList.remove('show');
    }
});

// ===== WEBSOCKET =====
var ws = new WebSocket(wsProtocol + window.location.host + '/ws/medecin/');
ws.onopen = function() { console.log('WS connected'); };
ws.onmessage = function(e) {
    var data = JSON.parse(e.data);
    if (data.type === 'chat_message') { ajouterMessage(data.message, data.expediteur); notifyChatMessage(); }
    else if (data.type === 'signe_vital') updateVitals(data);
    else if (data.type === 'alerte_urgente') showToast('🚨 Alerte urgente du patient !', 'error');
    else if (data.type === 'media_state' && data.from === 'patient') {
        document.getElementById('remote-mic-off').style.display = data.audio ? 'none' : 'block';
        document.getElementById('remote-cam-off').style.display = data.video ? 'none' : 'block';
    }
    else if (data.type === 'patient_joined_live') {
        document.getElementById('connection-status').textContent = 'Patient connecté ✓';
        document.getElementById('connection-status').classList.add('connected');
        // Relancer WebRTC si le patient rejoint/reprend
        if (peerConnection) {
            peerConnection.close();
            peerConnection = null;
        }
        setTimeout(startCall, 1000);
    }
    else if (data.type === 'webrtc_answer') handleAnswer(data.data);
    else if (data.type === 'webrtc_ice') handleIceCandidate(data.data);
};

// ===== WEBRTC =====
navigator.mediaDevices.getUserMedia({ video: true, audio: true })
    .then(function(stream) {
        localStream = stream;
        document.getElementById('localVideo').srcObject = stream;
        setTimeout(startCall, 1500);
    })
    .catch(function(err) { console.log('Camera error:', err); });

function startCall() {
    peerConnection = new RTCPeerConnection(STUN_SERVERS);
    if (localStream) localStream.getTracks().forEach(function(t) { peerConnection.addTrack(t, localStream); });
    peerConnection.ontrack = function(e) { document.getElementById('remoteVideo').srcObject = e.streams[0]; var s = document.getElementById('connection-status'); s.innerHTML = '<i class="fas fa-circle" style="font-size:8px;margin-right:6px;"></i>Patient connecté'; s.classList.add('connected'); s.style.color = ''; };
    peerConnection.onicecandidate = function(e) {
        if (e.candidate) ws.send(JSON.stringify({action:'webrtc_ice',consultation_id:consultationId,data:e.candidate}));
    };
    peerConnection.createOffer()
        .then(function(o) { return peerConnection.setLocalDescription(o).then(function(){return o;}); })
        .then(function(o) { ws.send(JSON.stringify({action:'webrtc_offer',consultation_id:consultationId,data:o})); });
}

function handleAnswer(a) { if (peerConnection) peerConnection.setRemoteDescription(new RTCSessionDescription(a)); }
function handleIceCandidate(c) {
    if (peerConnection && c) peerConnection.addIceCandidate(new RTCIceCandidate(c)).catch(function(){});
}

function toggleMic() {
    if (!localStream) return;
    micOn = !micOn;
    localStream.getAudioTracks().forEach(function(t) { t.enabled = micOn; });
    ws.send(JSON.stringify({action: 'media_state', consultation_id: consultationId, audio: micOn, video: camOn}));
    var btn = document.getElementById('btn-mic');
    btn.classList.toggle('off', !micOn);
    btn.innerHTML = '<i class="fa-solid fa-microphone' + (micOn ? '' : '-slash') + '"></i>';
}

function toggleCamera() {
    if (!localStream) return;
    camOn = !camOn;
    localStream.getVideoTracks().forEach(function(t) { t.enabled = camOn; });
    ws.send(JSON.stringify({action: 'media_state', consultation_id: consultationId, audio: micOn, video: camOn}));
    var btn = document.getElementById('btn-cam');
    btn.classList.toggle('off', !camOn);
    btn.innerHTML = '<i class="fa-solid fa-video' + (camOn ? '' : '-slash') + '"></i>';
}

// ===== CAPTEURS =====
function toggleCapteur(capteur) {
    capteurStates[capteur] = !capteurStates[capteur];
    var sw = document.getElementById('switch-' + capteur);
    sw.classList.toggle('on', capteurStates[capteur]);
    sw.classList.toggle('off', !capteurStates[capteur]);
    if (!capteurStates[capteur]) {
        if (capteur === 'spo2') { document.getElementById('spo2').textContent = 'OFF'; document.getElementById('fc').textContent = 'OFF'; }
        else if (capteur === 'temperature') { document.getElementById('temp').textContent = 'OFF'; }
        else document.getElementById('temp').textContent = '--';
    }
    if (capteurStates[capteur]) {
        if (capteur === 'spo2') { document.getElementById('spo2').textContent = '--'; document.getElementById('fc').textContent = '--'; }
        else if (capteur === 'temperature') { document.getElementById('temp').textContent = '--'; }
    }
    fetch('/api/sensors/controler/', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
        body: JSON.stringify({consultation_id: consultationId, capteur: capteur, actif: capteurStates[capteur]})
    });
}

function updateVitals(data) {
    if (capteurStates['spo2']) {
        if (data.spo2 != null) document.getElementById('spo2').textContent = data.spo2;
        if (data.frequence_cardiaque != null) document.getElementById('fc').textContent = data.frequence_cardiaque;
    }
    if (capteurStates['temperature']) {
        if (data.temperature != null) document.getElementById('temp').textContent = data.temperature;
    }
}

// ===== CHAT =====
function ajouterMessage(message, expediteur) {
    var div = document.createElement('div');
    div.className = 'chat-msg';
    var color = expediteur === 'medecin' ? '#1976d2' : '#43a047';
    var label = expediteur === 'medecin' ? 'Vous' : 'Patient';
    if (message.startsWith('[IMAGE]')) {
        var url = message.replace('[IMAGE]', '');
        div.innerHTML = '<strong style="color:' + color + '">' + label + '</strong>:<br><img src="' + url + '" onclick="window.open(this.src)">';
    } else {
        div.innerHTML = '<strong style="color:' + color + '">' + label + '</strong>: ' + message;
    }
    var msgs = document.getElementById('chat-messages');
    msgs.appendChild(div);
    msgs.scrollTop = 99999;
}

function envoyerMessage() {
    var input = document.getElementById('chat-input');
    var msg = input.value.trim();
    if (!msg) return;
    ws.send(JSON.stringify({action:'chat_message',consultation_id:consultationId,message:msg,expediteur:'medecin'}));
    ajouterMessage(msg, 'medecin');
    input.value = '';
}

function envoyerSiEnter(e) { if (e.key === 'Enter') envoyerMessage(); }

function envoyerImage(input) {
    var file = input.files[0];
    if (!file) return;
    var fd = new FormData();
    fd.append('image', file);
    fd.append('consultation_id', consultationId);
    fd.append('expediteur', 'medecin');
    fd.append('csrfmiddlewaretoken', csrfToken);
    fetch('/api/chat/upload-image/', {method:'POST',body:fd})
        .then(function(r){return r.json();})
        .then(function(){});
    input.value = '';
}

// ===== INIT =====
initLists();

// Pre-fill existing data
// Allergies gérées par cases à cocher maintenant
{% if patient.groupe_sanguin %}
document.getElementById('groupe-sanguin').value = '{{ patient.groupe_sanguin }}';
{% endif %}

// Pre-select existing symptoms
{% for s in consultation.symptomes.all %}
selectedSymptomes.add('{{ s.nom_symptome|escapejs }}');
{% endfor %}
document.getElementById('symptomes-count').textContent = selectedSymptomes.size + ' symptôme(s) sélectionné(s)';

// Pre-select existing maladies
{% for m in consultation.maladies_set.all %}
selectedMaladies.add('{{ m.nom_maladie|escapejs }}');
{% endfor %}

// Pre-fill mesures
{% with consultation.mesures_anthropo.first as ma %}
{% if ma %}
{% if ma.poids_kg %}document.getElementById('poids').value = '{{ ma.poids_kg }}'; {% endif %}
{% if ma.taille_cm %}document.getElementById('taille').value = '{{ ma.taille_cm }}'; {% endif %}
calcIMC();
{% endif %}
{% endwith %}

</script>
<style>
@keyframes slideIn { from {opacity:0;transform:translateX(100px);} to {opacity:1;transform:translateX(0);} }
</style>

<div class="mobile-tab-bar">
    <div class="mobile-tab-bar-inner">
        <button class="mob-tab active" onclick="showMobPanel('video')">
            <i class="fa-solid fa-video"></i>
            Vidéo
        </button>
        <button class="mob-tab" onclick="showMobPanel('infos')">
            <i class="fa-solid fa-user"></i>
            Infos
        </button>
        <button class="mob-tab" onclick="showMobPanel('chat')">
            <i class="fa-solid fa-comment"></i>
            Chat
        </button>
    </div>
</div>

<script>
function showMobPanel(panel) {
    var sidebar = document.querySelector('.live-sidebar');
    var center = document.querySelector('.live-center');
    var right = document.querySelector('.live-right');
    var tabs = document.querySelectorAll('.mob-tab');
    
    tabs.forEach(function(t) { t.classList.remove('active'); });
    event.currentTarget.classList.add('active');

    if (!sidebar || !center || !right) return;

    sidebar.classList.remove('mob-visible');
    center.classList.remove('mob-hidden');
    right.classList.remove('mob-visible');

    if (panel === 'infos') {
        sidebar.classList.add('mob-visible');
        center.classList.add('mob-hidden');
    } else if (panel === 'chat') {
        right.classList.add('mob-visible');
        center.classList.add('mob-hidden');
    }
}
</script>
</body>
</html>
