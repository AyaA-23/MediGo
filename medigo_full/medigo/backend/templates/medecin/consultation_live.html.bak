<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/static/images/favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultation — {{ patient }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root {
            --navy: #1a2a4a;
            --cyan: #00bcd4;
            --blue: #1976d2;
            --green: #43a047;
            --orange: #fb8c00;
            --red: #e53935;
            --teal: #00897b;
            --bg: #f0f4f8;
            --white: #ffffff;
            --border: #e2e8f0;
            --text: #1a2a4a;
            --text-muted: #7a8caa;
            --shadow: 0 4px 24px rgba(26,42,74,0.08);
            --radius: 12px;
            --radius-sm: 8px;
            --sidebar-w: 345px;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* HEADER */
        .live-header {
            height: 62px;
            background: white;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            gap: 1rem;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(26,42,74,0.06);
            z-index: 10;
        }
        .live-header img { height: 38px; }
        .live-header-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--navy);
        }
        .live-header-status {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--orange);
            margin-left: 0.5rem;
        }
        .live-header-status.connected { color: var(--green); }
        .header-btns { margin-left: auto; display: flex; gap: 0.75rem; }

        /* MAIN LAYOUT */
        .live-body {
            flex: 1;
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr 320px;
            overflow: hidden;
        }

        /* LEFT SIDEBAR */
        .live-sidebar {
            background: white;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .sidebar-tabs {
            display: flex;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }
        .sidebar-tab {
            flex: 1;
            padding: 0.75rem 0.25rem;
            text-align: center;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .sidebar-tab.active {
            color: var(--blue);
            border-bottom-color: var(--blue);
            background: var(--bg);
        }
        .sidebar-panel {
            display: none;
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }
        .sidebar-panel.active { display: flex; flex-direction: column; gap: 0.75rem; }

        .form-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 0.35rem;
            display: block;
        }
        .form-input {
            width: 100%;
            padding: 0.6rem 0.875rem;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.875rem;
            color: var(--text);
            outline: none;
            transition: all 0.2s;
            background: var(--bg);
        }
        .form-input:focus {
            border-color: var(--cyan);
            background: white;
            box-shadow: 0 0 0 3px rgba(0,188,212,0.1);
        }
        select.form-input { cursor: pointer; }

        .imc-display {
            background: linear-gradient(135deg, var(--blue), var(--cyan));
            color: white;
            border-radius: var(--radius-sm);
            padding: 0.75rem;
            text-align: center;
        }
        .imc-value { font-size: 1.5rem; font-weight: 800; }
        .imc-label { font-size: 0.75rem; opacity: 0.85; }

        .save-btn {
            width: 100%;
            padding: 0.6rem;
            background: var(--navy);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        .save-btn:hover { background: var(--blue); }

        /* SYMPTOMES */
        .search-symptoms {
            position: relative;
        }
        .search-symptoms input {
            width: 100%;
            padding: 0.6rem 0.875rem 0.6rem 2.25rem;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.82rem;
            outline: none;
            transition: all 0.2s;
            background: var(--bg);
        }
        .search-symptoms input:focus { border-color: var(--cyan); background: white; }
        .search-symptoms i {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 0.8rem;
        }
        .symptoms-list {
            flex: 1;
            overflow-y: auto;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--bg);
            max-height: 280px;
        }
        .symptom-item {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            padding: 0.5rem 0.875rem;
            cursor: pointer;
            transition: background 0.15s;
            font-size: 0.82rem;
            border-bottom: 1px solid rgba(0,0,0,0.04);
        }
        .symptom-item:hover { background: white; }
        .symptom-item input[type=checkbox] { accent-color: var(--blue); cursor: pointer; }
        .symptom-item.checked { background: var(--blue-light, #e3f2fd); font-weight: 600; color: var(--blue); }
        .selected-count {
            font-size: 0.78rem;
            color: var(--blue);
            font-weight: 600;
            text-align: right;
        }

        /* MALADIES */
        .maladies-list {
            flex: 1;
            overflow-y: auto;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--bg);
            max-height: 200px;
        }

        /* CENTER — VIDEO */
        .live-center {
            display: flex;
            flex-direction: column;
            padding: 0.75rem;
            gap: 0.5rem;
            overflow: hidden;
        }
        .video-main {
            flex: 1;
            position: relative;
            background: #000;
            border-radius: var(--radius);
            overflow: hidden;
            min-height: 0;
        }
        .video-pip {
            position: absolute;
            bottom: 0.75rem;
            right: 0.875rem;
            width: 160px;
            aspect-ratio: 4/3;
            border-radius: var(--radius-sm);
            overflow: hidden;
            border: 2px solid rgba(255,255,255,0.3);
            box-shadow: 0 4px 16px rgba(0,0,0,0.4);
            z-index: 5;
            background: #1a2a4a;
        }
        .video-pip video { width: 100%; height: 100%; object-fit: cover; }
        .video-pip-label {
            position: absolute;
            bottom: 0.3rem;
            left: 0.4rem;
            background: rgba(0,0,0,0.55);
            color: white;
            padding: 0.15rem 0.5rem;
            border-radius: 50px;
            font-size: 0.68rem;
            font-weight: 600;
        }
        .video-pip-controls {
            position: absolute;
            bottom: 0.3rem;
            right: 0.4rem;
            display: flex;
            gap: 0.3rem;
        }
        .video-main video {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #000;
        }
        .video-main-label {
            position: absolute;
            bottom: 0.75rem;
            left: 0.875rem;
            background: rgba(0,0,0,0.55);
            color: white;
            padding: 0.3rem 0.75rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        /* PIP medecin overlay */
        .video-pip {
            position: absolute;
            bottom: 0.75rem;
            right: 0.875rem;
            width: 160px;
            aspect-ratio: 4/3;
            border-radius: var(--radius-sm);
            overflow: hidden;
            border: 2px solid rgba(255,255,255,0.3);
            box-shadow: 0 4px 16px rgba(0,0,0,0.4);
            z-index: 5;
            background: #1a2a4a;
        }
        .video-pip video { width: 100%; height: 100%; object-fit: cover; }
        .video-pip-label {
            position: absolute;
            bottom: 0.3rem;
            left: 0.4rem;
            background: rgba(0,0,0,0.55);
            color: white;
            padding: 0.15rem 0.5rem;
            border-radius: 50px;
            font-size: 0.68rem;
            font-weight: 600;
        }
        .video-pip-controls {
            position: absolute;
            bottom: 0.3rem;
            right: 0.4rem;
            display: flex;
            gap: 0.3rem;
        }
        .ctrl-btn {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            border: none;
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            transition: background 0.2s;
        }
        .ctrl-btn:hover { background: rgba(255,255,255,0.45); }
        .ctrl-btn.off { background: var(--red); }
        /* VITALS BAR */
        .vitals-bar {
            display: flex;
            gap: 0.5rem;
            flex-shrink: 0;
        }
        .vital-card {
            flex: 1;
            border-radius: var(--radius-sm);
            padding: 0.6rem;
            text-align: center;
            color: white;
            font-weight: 800;
        }
        .vital-card.spo2 { background: linear-gradient(135deg, #1565c0, #1976d2); }
        .vital-card.fc { background: linear-gradient(135deg, #c62828, #e53935); }
        .vital-card.temp { background: linear-gradient(135deg, #e65100, #fb8c00); }
        .vital-value { font-size: 1.3rem; line-height: 1; }
        .vital-label { font-size: 0.68rem; opacity: 0.85; margin-top: 0.15rem; }

        /* RIGHT PANEL */
        .live-right {
            background: white;
            border-left: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .right-section {
            padding: 0.875rem;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }
        .right-section-title {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            margin-bottom: 0.625rem;
        }
        .sensor-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }
        .sensor-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--teal);
            color: white;
            padding: 0.4rem 0.875rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .switch {
            display: inline-flex;
            background: #eee;
            border-radius: 50px;
            padding: 0.2rem;
            cursor: pointer;
            transition: all 0.3s;
        }
        .switch-opt {
            padding: 0.3rem 0.625rem;
            border-radius: 50px;
            font-size: 0.72rem;
            font-weight: 700;
            transition: all 0.3s;
            color: var(--text-muted);
        }
        .switch.on .switch-on {
            background: var(--green);
            color: white;
            box-shadow: 0 2px 6px rgba(67,160,71,0.4);
        }
        .switch.off .switch-off {
            background: var(--red);
            color: white;
            box-shadow: 0 2px 6px rgba(229,57,53,0.35);
        }

        /* CHAT */
        /* AI SUGGESTIONS */
        .ai-suggestions {
            padding: 0.75rem;
            flex: 1;
            overflow-y: auto;
        }
        .ai-box {
            background: linear-gradient(135deg, #f8f9ff, #eef2ff);
            border: 1px solid #c5cae9;
            border-radius: var(--radius-sm);
            padding: 0.75rem;
            margin-bottom: 0.5rem;
        }
        .ai-box-title {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #5c6bc0;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .ai-disease {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.35rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            font-size: 0.82rem;
        }
        .ai-disease:last-child { border-bottom: none; }
        .ai-disease-name { font-weight: 600; color: var(--navy); }
        .ai-confidence {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 20px;
        }
        .ai-confidence.high { background: #ffebee; color: #c62828; }
        .ai-confidence.medium { background: #fff3e0; color: #e65100; }
        .ai-confidence.low { background: #e8f5e9; color: #2e7d32; }
        .ai-question {
            font-size: 0.8rem;
            color: var(--text);
            padding: 0.3rem 0;
            display: flex;
            align-items: flex-start;
            gap: 0.4rem;
        }
        .ai-question i { color: #5c6bc0; font-size: 0.7rem; margin-top: 0.2rem; flex-shrink: 0; }
        .ai-disclaimer {
            font-size: 0.68rem;
            color: var(--text-muted);
            font-style: italic;
            text-align: center;
            padding: 0.4rem;
            border-top: 1px solid var(--border);
            margin-top: 0.5rem;
        }
        .ai-empty {
            text-align: center;
            color: var(--text-muted);
            padding: 2rem 1rem;
            font-size: 0.85rem;
        }
        .ai-empty i { font-size: 1.5rem; opacity: 0.3; display: block; margin-bottom: 0.5rem; }
        /* CHAT POPUP */
        .chat-fab {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--blue), var(--cyan));
            color: white;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            box-shadow: 0 4px 20px rgba(25,118,210,0.4);
            z-index: 200;
            transition: all 0.2s;
        }
        .chat-fab:hover { transform: scale(1.1); }
        .chat-fab-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--red);
            color: white;
            font-size: 0.65rem;
            font-weight: 800;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .chat-popup {
            position: fixed;
            bottom: 5rem;
            right: 1.5rem;
            width: 340px;
            max-height: 420px;
            background: white;
            border-radius: var(--radius);
            box-shadow: 0 12px 48px rgba(0,0,0,0.2);
            border: 1px solid var(--border);
            display: none;
            flex-direction: column;
            z-index: 199;
            animation: chatSlideUp 0.3s ease;
        }
        .chat-popup.show { display: flex; }
        @keyframes chatSlideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .chat-popup-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border);
            background: var(--bg);
            border-radius: var(--radius) var(--radius) 0 0;
        }
        .chat-popup-header-title { font-weight: 700; font-size: 0.9rem; color: var(--navy); }
        .chat-popup-close { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem; }
        .chat-popup-close:hover { color: var(--red); }
        .chat-popup-messages {
            flex: 1;
            overflow-y: auto;
            padding: 0.75rem;
            max-height: 280px;
        }
        .chat-popup-input {
            display: flex;
            gap: 0.4rem;
            padding: 0.6rem 0.75rem;
            border-top: 1px solid var(--border);
            align-items: center;
        }
        .chat-popup-input input {
            flex: 1;
            padding: 0.5rem 0.75rem;
            border: 1.5px solid var(--border);
            border-radius: 50px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.85rem;
            outline: none;
        }
        .chat-popup-input input:focus { border-color: var(--cyan); }
        .chat-popup-btn {
            width: 34px; height: 34px;
            border-radius: 50%;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 0.85rem;
            flex-shrink: 0;
        }
        .chat-popup-btn-send { background: var(--blue); color: white; }
        .chat-popup-btn-img { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); }
        .chat-msg { padding: 0.3rem 0; border-bottom: 1px solid rgba(0,0,0,0.05); font-size: 0.85rem; }
        .chat-msg img { max-width: 120px; border-radius: 6px; margin-top: 3px; display: block; cursor: pointer; }

        .chat-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding: 0.875rem;
        }
        .chat-title {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            margin-bottom: 0.625rem;
            flex-shrink: 0;
        }
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            background: var(--bg);
            border-radius: var(--radius-sm);
            padding: 0.75rem;
            font-size: 0.82rem;
            margin-bottom: 0.625rem;
            min-height: 0;
        }
        .chat-msg { padding: 0.3rem 0; border-bottom: 1px solid rgba(0,0,0,0.05); }
        .chat-msg img { max-width: 120px; border-radius: 6px; margin-top: 3px; display: block; cursor: pointer; }
        .chat-input-row {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-shrink: 0;
        }
        .chat-input-row input {
            flex: 1;
            padding: 0.6rem 0.75rem;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.82rem;
            outline: none;
            transition: all 0.2s;
        }
        .chat-input-row input:focus { border-color: var(--cyan); }
        .chat-send {
            padding: 0.6rem 0.875rem;
            background: var(--navy);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 600;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all 0.2s;
        }
        .chat-send:hover { background: var(--blue); }
        .img-btn {
            width: 32px;
            height: 32px;
            background: var(--bg);
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .img-btn:hover { border-color: var(--cyan); color: var(--cyan); }

        /* BUTTONS */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.5rem 1.1rem;
            border-radius: 50px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            text-decoration: none;
            white-space: nowrap;
        }
        .btn:hover { transform: translateY(-1px); }
        .btn-success { background: var(--green); color: white; }
        .btn-success:hover { box-shadow: 0 4px 12px rgba(67,160,71,0.35); }
        .btn-danger { background: var(--red); color: white; }
        .btn-danger:hover { box-shadow: 0 4px 12px rgba(229,57,53,0.35); }
        .btn-primary { background: var(--blue); color: white; }

        .spinner { width:16px;height:16px;border:2px solid rgba(255,255,255,0.3);border-top-color:white;border-radius:50%;animation:spin 0.7s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        .section-divider {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .section-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        /* ===== RESPONSIVE ===== */
        .mobile-tab-bar {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            border-top: 1px solid var(--border);
            z-index: 100;
            padding: 0.4rem 0;
            box-shadow: 0 -2px 12px rgba(0,0,0,0.1);
        }
        .mobile-tab-bar-inner {
            display: flex;
            justify-content: space-around;
        }
        .mob-tab {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.15rem;
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0.3rem 0.5rem;
            border: none;
            background: none;
            font-family: inherit;
        }
        .mob-tab.active { color: var(--blue); }
        .mob-tab i { font-size: 1.1rem; }

        @media (max-width: 1024px) {
            .live-body {
                grid-template-columns: 1fr;
                grid-template-rows: 1fr;
            }
            .live-sidebar {
                display: none;
                position: fixed;
                top: 62px;
                left: 0;
                right: 0;
                bottom: 50px;
                z-index: 90;
                border-right: none;
            }
            .live-sidebar.mob-visible {
                display: flex;
            }
            .live-right {
                display: none;
                position: fixed;
                top: 62px;
                right: 0;
                bottom: 50px;
                width: 100%;
                z-index: 90;
            }
            .live-right.mob-visible {
                display: flex;
            }
            .live-center {
                display: flex;
                flex-direction: column;
            }
            .live-center.mob-hidden {
                display: none;
            }
            .mobile-tab-bar {
                display: block;
            }
            body {
                padding-bottom: 50px;
            }
            .live-header {
                padding: 0 0.75rem;
                gap: 0.5rem;
            }
            .live-header-title {
                font-size: 0.85rem;
            }
            .header-btns .btn {
                font-size: 0.75rem;
                padding: 0.4rem 0.75rem;
            }
            .live-header img {
                height: 30px;
            }
        }

        @media (max-width: 768px) {
            .live-header {
                height: 52px;
            }
            .live-sidebar {
                top: 52px;
            }
            .live-right {
                top: 52px;
            }
            .vitals-bar {
                flex-direction: row;
                gap: 0.5rem;
            }
            .vital-box {
                padding: 0.5rem;
                font-size: 0.8rem;
            }
            .vital-box .vital-value {
                font-size: 1.2rem;
            }
            .local-video-wrapper {
                width: 100px !important;
                bottom: 0.5rem !important;
                right: 0.5rem !important;
            }
        }

        @media (max-width: 480px) {
            .header-btns .btn span.btn-text {
                display: none;
            }
            .live-header-status {
                font-size: 0.75rem;
            }
        }
    </style>
</head>
<body>

<!-- HEADER -->
<div class="live-header">
    <img src="/static/images/logo.png" alt="Medigo">
    <div>
        <div class="live-header-title">Consultation — {{ patient.prenom }} {{ patient.nom }}</div>
    </div>
    <span id="connection-status" class="live-header-status">En attente patient...</span>
    <div class="header-btns">
        <a href="{% url 'creer_ordonnance' consultation.id %}" class="btn btn-success" onclick="notifierPatientPreparation(event, this.href, true)">
            <i class="fa-solid fa-prescription"></i> Clôturer Avec Ordonnance
        </a>
        <a href="{% url 'cloturer_consultation' consultation.id %}" class="btn btn-danger" onclick="notifierPatientPreparation(event, this.href, false)">
            <i class="fa-solid fa-xmark"></i> Clôturer Sans Ordonnance
        </a>
    </div>
</div>

<!-- BODY -->
<div class="live-body">

    <!-- LEFT SIDEBAR -->
    <div class="live-sidebar">
        <div class="sidebar-tabs">
            <div class="sidebar-tab active" onclick="showTab('patient')">
                <i class="fa-solid fa-user"></i><br>Patient
            </div>
            <div class="sidebar-tab" onclick="showTab('symptomes')">
                <i class="fa-solid fa-stethoscope"></i><br>Sympt.
            </div>
            <div class="sidebar-tab" onclick="showTab('maladies')">
                <i class="fa-solid fa-virus"></i><br>Maladies
            </div>
            <div class="sidebar-tab" onclick="showTab('mesures')">
                <i class="fa-solid fa-ruler"></i><br>Mesures
            </div>
        </div>

        <!-- PATIENT PANEL -->
        <div class="sidebar-panel active" id="panel-patient">
            <!-- Info patient card -->
            <div style="background:var(--bg);border-radius:var(--radius-sm);padding:0.6rem;font-size:0.8rem;border:1px solid var(--border);">
                <div style="font-weight:700;color:var(--navy);margin-bottom:0.4rem;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.05em;">
                    <i class="fa-solid fa-circle-info" style="color:var(--blue);margin-right:0.3rem;"></i>Patient
                </div>
                <div style="color:var(--text-muted);line-height:1.7;font-size:0.78rem;">
                    <strong>{{ patient.prenom }} {{ patient.nom }}</strong> · {{ patient.age }} ans · {{ patient.get_sexe_display|default:"—" }}<br>
                    CIN: {{ patient.cin }} · Tél: {{ patient.telephone }}
                </div>
            </div>

            <!-- Groupe sanguin -->
            <div>
                <label class="form-label">Groupe sanguin</label>
                <select class="form-input" id="groupe-sanguin">
                    <option value="">— Sélectionner —</option>
                    <option {% if patient.groupe_sanguin == 'A+' %}selected{% endif %}>A+</option>
                    <option {% if patient.groupe_sanguin == 'A-' %}selected{% endif %}>A-</option>
                    <option {% if patient.groupe_sanguin == 'B+' %}selected{% endif %}>B+</option>
                    <option {% if patient.groupe_sanguin == 'B-' %}selected{% endif %}>B-</option>
                    <option {% if patient.groupe_sanguin == 'AB+' %}selected{% endif %}>AB+</option>
                    <option {% if patient.groupe_sanguin == 'AB-' %}selected{% endif %}>AB-</option>
                    <option {% if patient.groupe_sanguin == 'O+' %}selected{% endif %}>O+</option>
                    <option {% if patient.groupe_sanguin == 'O-' %}selected{% endif %}>O-</option>
                </select>
            </div>

            <!-- Allergies -->
            <div>
                <label class="form-label">Allergies</label>
                <div class="search-symptoms" style="margin-bottom:0.4rem;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" placeholder="Rechercher allergie..." oninput="filterAllergies(this.value)" id="allergie-search">
                </div>
                <div id="allergies-list" style="max-height:120px;overflow-y:auto;"></div>
                <div id="add-allergie-box" style="display:none;margin-top:0.4rem;">
                    <div style="display:flex;gap:0.4rem;">
                        <input type="text" id="custom-allergie-input" placeholder="Autre allergie..." style="flex:1;padding:0.4rem 0.6rem;border:1.5px solid var(--cyan);border-radius:6px;font-size:0.82rem;font-family:inherit;">
                        <button onclick="ajouterAllergieCustom()" style="background:var(--cyan);color:white;border:none;border-radius:6px;padding:0.4rem 0.6rem;cursor:pointer;font-size:0.82rem;"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </div>
                <div id="selected-allergies" style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-top:0.4rem;"></div>
            </div>

            <!-- Tabac / Alcool / Activité -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;">
                <div>
                    <label class="form-label">Tabac</label>
                    <select class="form-input" id="tabac" style="font-size:0.8rem;padding:0.45rem;">
                        <option value="non_fumeur">Non fumeur</option>
                        <option value="fumeur">Fumeur</option>
                        <option value="ancien_fumeur">Ancien fumeur</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Alcool</label>
                    <select class="form-input" id="alcool" style="font-size:0.8rem;padding:0.45rem;">
                        <option value="jamais">Jamais</option>
                        <option value="occasionnel">Occasionnel</option>
                        <option value="regulier">Régulier</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="form-label">Activité physique</label>
                <select class="form-input" id="activite-physique" style="font-size:0.8rem;padding:0.45rem;">
                    <option value="sedentaire">Sédentaire</option>
                    <option value="peu_actif">Peu actif</option>
                    <option value="actif">Actif</option>
                    <option value="tres_actif">Très actif</option>
                </select>
            </div>

            <!-- Grossesse (visible si femme) -->
            {% if patient.sexe == 'F' %}
            <div>
                <label class="form-label">Enceinte</label>
                <div style="display:flex;gap:0.5rem;">
                    <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.85rem;cursor:pointer;">
                        <input type="radio" name="enceinte" value="true" id="enceinte-oui"> Oui
                    </label>
                    <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.85rem;cursor:pointer;">
                        <input type="radio" name="enceinte" value="false" id="enceinte-non" checked> Non
                    </label>
                </div>
            </div>
            {% endif %}

            <!-- Maladie chronique -->
            <div>
                <label class="form-label">Maladie chronique ?</label>
                <div style="display:flex;gap:0.5rem;margin-bottom:0.4rem;">
                    <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.85rem;cursor:pointer;">
                        <input type="radio" name="chronique" value="oui" onclick="document.getElementById('chronique-list').style.display='block'"> Oui
                    </label>
                    <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.85rem;cursor:pointer;">
                        <input type="radio" name="chronique" value="non" checked onclick="document.getElementById('chronique-list').style.display='none'"> Non
                    </label>
                </div>
                <div id="chronique-list" style="display:none;">
                    <div class="search-symptoms" style="margin-bottom:0.3rem;">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Rechercher maladie chronique..." oninput="filterChroniques(this.value)" id="chronique-search">
                    </div>
                    <div id="chroniques-list-items" style="max-height:100px;overflow-y:auto;"></div>
                    <div id="selected-chroniques" style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-top:0.4rem;"></div>
                </div>
            </div>

            <button class="save-btn" onclick="sauvegarderPatient()">
                <i class="fa-solid fa-floppy-disk"></i> Sauvegarder
            </button>
            <div id="patient-saved-msg" style="display:none;font-size:0.8rem;font-weight:700;margin-top:0.4rem;text-align:center;border-radius:6px;padding:0.35rem;"></div>
        </div>

        <!-- SYMPTOMES PANEL -->
        <div class="sidebar-panel" id="panel-symptomes">
            <div class="selected-count" id="symptomes-count">0 symptôme(s)</div>
            <div class="search-symptoms">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Rechercher un symptôme..." oninput="filterSymptomes(this.value)" id="symptome-search">
            </div>
            <div class="symptoms-list" id="symptomes-list" style="max-height:180px;overflow-y:auto;"></div>
            <div class="add-custom" id="add-symptome-box" style="display:none;margin:0.4rem 0;">
                <div style="display:flex;gap:0.4rem;">
                    <input type="text" id="custom-symptome-input" placeholder="Nouveau symptôme..." style="flex:1;padding:0.4rem 0.6rem;border:1.5px solid var(--cyan);border-radius:6px;font-size:0.82rem;font-family:inherit;">
                    <button onclick="ajouterSymptomeCustom()" style="background:var(--cyan);color:white;border:none;border-radius:6px;padding:0.4rem 0.6rem;cursor:pointer;font-size:0.82rem;"><i class="fa-solid fa-plus"></i></button>
                </div>
            </div>
            <!-- Symptômes sélectionnés avec intensité/évolution -->
            <div id="symptomes-details" style="margin-top:0.5rem;max-height:200px;overflow-y:auto;border-top:1px solid var(--border);padding-top:0.5rem;"></div>
            <div style="margin-top:0.5rem;">
                <button class="save-btn" style="width:100%;" onclick="sauvegarderSymptomes()">
                    <i class="fa-solid fa-floppy-disk"></i> Sauvegarder
                </button>
                <div id="symptomes-saved-msg" style="display:none;color:#43a047;font-size:0.8rem;font-weight:700;margin-top:0.4rem;text-align:center;background:#e8f5e9;border-radius:6px;padding:0.35rem;"></div>
            </div>
        </div>

        <!-- MALADIES PANEL -->
        <div class="sidebar-panel" id="panel-maladies">
            <div class="selected-count" id="maladies-count">0 maladie(s)</div>
            <div class="search-symptoms">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Rechercher une maladie..." oninput="filterMaladies(this.value)" id="maladie-search">
            </div>
            <div class="maladies-list" id="maladies-list" style="max-height:250px;overflow-y:auto;"></div>
            <div class="add-custom" id="add-maladie-box" style="display:none;margin:0.4rem 0;">
                <div style="display:flex;gap:0.4rem;">
                    <input type="text" id="custom-maladie-input" placeholder="Nouvelle maladie..." style="flex:1;padding:0.4rem 0.6rem;border:1.5px solid var(--cyan);border-radius:6px;font-size:0.82rem;font-family:inherit;">
                    <button onclick="ajouterMaladieCustom()" style="background:var(--cyan);color:white;border:none;border-radius:6px;padding:0.4rem 0.6rem;cursor:pointer;font-size:0.82rem;"><i class="fa-solid fa-plus"></i></button>
                </div>
            </div>
            <div style="margin-top:0.5rem;">
                <button class="save-btn" style="width:100%;" onclick="sauvegarderMaladies()">
                    <i class="fa-solid fa-floppy-disk"></i> Sauvegarder
                </button>
                <div id="maladies-saved-msg" style="display:none;color:#43a047;font-size:0.8rem;font-weight:700;margin-top:0.4rem;text-align:center;background:#e8f5e9;border-radius:6px;padding:0.35rem;"></div>
            </div>
        </div>

        <!-- MESURES PANEL -->
        <div class="sidebar-panel" id="panel-mesures">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;">
                <div>
                    <label class="form-label">Poids (kg)</label>
                    <input type="number" class="form-input" id="poids" placeholder="70" step="0.1" min="1" max="300" oninput="calcIMC()">
                </div>
                <div>
                    <label class="form-label">Taille (cm)</label>
                    <input type="number" class="form-input" id="taille" placeholder="175" step="0.5" min="1" max="250" oninput="calcIMC()">
                </div>
            </div>
            <div class="imc-display" id="imc-display" style="display:none;margin-top:0.5rem;">
                <div class="imc-value" id="imc-value">--</div>
                <div class="imc-label">IMC (kg/m²)</div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;margin-top:0.5rem;">
                <div>
                    <label class="form-label">Tension SYS (mmHg)</label>
                    <input type="number" class="form-input" id="tension-sys" placeholder="120" min="60" max="250" oninput="interpTension()">
                </div>
                <div>
                    <label class="form-label">Tension DIA (mmHg)</label>
                    <input type="number" class="form-input" id="tension-dia" placeholder="80" min="30" max="150" oninput="interpTension()">
                </div>
            </div>
            <div id="tension-interp" style="display:none;font-size:0.78rem;font-weight:700;padding:0.3rem 0.6rem;border-radius:6px;margin-top:0.3rem;text-align:center;"></div>

            <div style="margin-top:0.5rem;">
                <label class="form-label">Glycémie (g/L)</label>
                <input type="number" class="form-input" id="glycemie" placeholder="0.90" step="0.01" min="0" max="6" oninput="interpGlycemie()">
            </div>
            <div id="glycemie-interp" style="display:none;font-size:0.78rem;font-weight:700;padding:0.3rem 0.6rem;border-radius:6px;margin-top:0.3rem;text-align:center;"></div>

            <button class="save-btn" style="margin-top:0.75rem;" onclick="sauvegarderMesures()">
                <i class="fa-solid fa-floppy-disk"></i> Sauvegarder mesures
            </button>
            <div id="mesures-saved-msg2" style="display:none;font-size:0.8rem;font-weight:700;margin-top:0.4rem;text-align:center;border-radius:6px;padding:0.35rem;"></div>
        </div>
    </div>
    <!-- CENTER VIDEO -->
    <div class="live-center">
        <div class="video-main">
            <video id="remoteVideo" autoplay playsinline></video>
            <div class="video-main-label">{{ patient.prenom }} {{ patient.nom }}</div>
            <div id="remote-media-overlay" style="position:absolute;top:0.75rem;left:0.75rem;display:flex;gap:0.5rem;z-index:5;">
                <div id="remote-mic-off" style="display:none;background:rgba(0,0,0,0.7);color:#ff5252;padding:0.35rem 0.6rem;border-radius:20px;font-size:0.75rem;font-weight:700;"><i class="fa-solid fa-microphone-slash"></i> Micro coupé</div>
                <div id="remote-cam-off" style="display:none;background:rgba(0,0,0,0.7);color:#ff5252;padding:0.35rem 0.6rem;border-radius:20px;font-size:0.75rem;font-weight:700;"><i class="fa-solid fa-video-slash"></i> Caméra coupée</div>
            </div>
            <div class="video-pip">
                <video id="localVideo" autoplay muted playsinline></video>
                <div class="video-pip-label">Vous</div>
                <div class="video-pip-controls">
                    <button class="ctrl-btn" id="btn-mic" onclick="toggleMic()" title="Micro">
                        <i class="fa-solid fa-microphone"></i>
                    </button>
                    <button class="ctrl-btn" id="btn-cam" onclick="toggleCamera()" title="Caméra">
                        <i class="fa-solid fa-video"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="vitals-bar">
            <div class="vital-card spo2">
                <div class="vital-value" id="spo2">OFF</div>
                <div class="vital-label">SpO2 %</div>
            </div>
            <div class="vital-card fc">
                <div class="vital-value" id="fc">OFF</div>
                <div class="vital-label">Bpm</div>
            </div>
            <div class="vital-card temp">
                <div class="vital-value" id="temp">OFF</div>
                <div class="vital-label">Temp °C</div>
            </div>
        </div>
    </div>
    <!-- RIGHT PANEL -->
    <div class="live-right">
        <div class="right-section">
            <div class="right-section-title">Contrôle Capteurs</div>
            <div class="sensor-row">
                <div class="sensor-label">
                    <i class="fa-solid fa-heart-pulse"></i> Oxymètre
                </div>
                <div class="switch off" id="switch-spo2" onclick="toggleCapteur('spo2')">
                    <span class="switch-opt switch-on">ON</span>
                    <span class="switch-opt switch-off">OFF</span>
                </div>
            </div>
            <div class="sensor-row">
                <div class="sensor-label">
                    <i class="fa-solid fa-thermometer"></i> Thermomètre
                </div>
                <div class="switch off" id="switch-temperature" onclick="toggleCapteur('temperature')">
                    <span class="switch-opt switch-on">ON</span>
                    <span class="switch-opt switch-off">OFF</span>
                </div>
            </div>
            <div style="margin-top:0.75rem;">
                <button class="save-btn" style="width:100%;margin:0;background:var(--green);" onclick="enregistrerMesures()">
                    <i class="fa-solid fa-floppy-disk"></i> Enregistrer les mesures
                </button>
                <div id="mesures-saved-msg" style="display:none;font-size:0.8rem;font-weight:700;margin-top:0.4rem;text-align:center;border-radius:6px;padding:0.35rem;"></div>
            </div>
            <div id="mesures-enregistrees" style="margin-top:0.75rem;display:none;">
                <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;color:var(--text-muted);letter-spacing:0.05em;margin-bottom:0.4rem;">Mesures enregistrées</div>
                <div style="display:flex;gap:0.4rem;">
                    <div style="flex:1;text-align:center;padding:0.4rem;background:var(--bg);border-radius:6px;border:1px solid var(--border);">
                        <div style="font-size:1rem;font-weight:800;color:var(--blue);" id="saved-spo2">--</div>
                        <div style="font-size:0.65rem;color:var(--text-muted);">SpO2</div>
                    </div>
                    <div style="flex:1;text-align:center;padding:0.4rem;background:var(--bg);border-radius:6px;border:1px solid var(--border);">
                        <div style="font-size:1rem;font-weight:800;color:var(--red);" id="saved-fc">--</div>
                        <div style="font-size:0.65rem;color:var(--text-muted);">FC</div>
                    </div>
                    <div style="flex:1;text-align:center;padding:0.4rem;background:var(--bg);border-radius:6px;border:1px solid var(--border);">
                        <div style="font-size:1rem;font-weight:800;color:var(--orange);" id="saved-temp">--</div>
                        <div style="font-size:0.65rem;color:var(--text-muted);">Temp</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- AI SUGGESTIONS -->
        <div class="ai-suggestions" id="ai-suggestions">
            <div class="ai-empty">
                <i class="fa-solid fa-robot"></i>
                Sélectionnez des symptômes pour voir les suggestions
            </div>
        </div>
    </div>

<!-- CHAT FAB + POPUP -->
<button class="chat-fab" onclick="toggleChatPopup()" id="chat-fab">
    <i class="fa-solid fa-comment-dots"></i>
    <div class="chat-fab-badge" id="chat-badge">0</div>
</button>

<div class="chat-popup" id="chat-popup">
    <div class="chat-popup-header">
        <div class="chat-popup-header-title"><i class="fa-solid fa-comment" style="color:var(--blue);margin-right:0.4rem;"></i> Messages</div>
        <button class="chat-popup-close" onclick="toggleChatPopup()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="chat-popup-messages" id="chat-messages"></div>
    <div class="chat-popup-input">
        <input type="text" id="chat-input" placeholder="Écrire un message..." onkeypress="envoyerSiEnter(event)">
        <label class="chat-popup-btn chat-popup-btn-img" title="Image">
            <i class="fa-solid fa-image"></i>
            <input type="file" accept="image/*" style="display:none;" onchange="envoyerImage(this)">
        </label>
        <button class="chat-popup-btn chat-popup-btn-send" onclick="envoyerMessage()">
            <i class="fa-solid fa-paper-plane"></i>
        </button>
    </div>
</div>
</div>

<script>
var consultationId = '{{ consultation.id }}';
var patientId = '{{ patient.id }}';
var localStream = null;
var peerConnection = null;
var micOn = true;
var camOn = true;
var wsProtocol = window.location.protocol === 'https:' ? 'wss://' : 'ws://';
var capteurStates = { spo2: false, temperature: false };
var csrfToken = '{{ csrf_token }}';

var STUN_SERVERS = {
    iceServers: [
        { urls: 'stun:stun.relay.metered.ca:80' },
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'turn:standard.relay.metered.ca:80', username: '6adf1563f68c94b54edd48f6', credential: 'a972UukmjErInCWB' },
        { urls: 'turn:standard.relay.metered.ca:80?transport=tcp', username: '6adf1563f68c94b54edd48f6', credential: 'a972UukmjErInCWB' },
