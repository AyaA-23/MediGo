    }).join('');
}

// ===== SYMPTOMES =====
function renderSymptomes(list) {
    var c = document.getElementById('symptomes-list');
    c.innerHTML = '';
    list.forEach(function(s) {
        var div = document.createElement('div');
        div.className = 'symptom-item' + (selectedSymptomes.has(s) ? ' checked' : '');
        div.innerHTML = '<input type="checkbox" ' + (selectedSymptomes.has(s) ? 'checked' : '') + '><span>' + s + '</span>';
        div.onclick = function() { toggleSymptome(s, div); };
        c.appendChild(div);
    });
}
function toggleSymptome(s, el) {
    if (selectedSymptomes.has(s)) {
        selectedSymptomes.delete(s);
        el.classList.remove('checked');
        el.querySelector('input').checked = false;
    } else {
        selectedSymptomes.set(s, {intensite: 0, evolution: 'stable'});
        el.classList.add('checked');
        el.querySelector('input').checked = true;
    }
    document.getElementById('symptomes-count').textContent = selectedSymptomes.size + ' symptôme(s)';
    renderSymptomesDetails();
    updateAISuggestions();
}
function renderSymptomesDetails() {
    var c = document.getElementById('symptomes-details');
    if (selectedSymptomes.size === 0) { c.innerHTML = ''; return; }
    var html = '<div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.3rem;">Détails symptômes</div>';
    selectedSymptomes.forEach(function(data, nom) {
        html += '<div style="background:var(--bg);border-radius:6px;padding:0.4rem 0.6rem;margin-bottom:0.3rem;border:1px solid var(--border);font-size:0.78rem;">' +
            '<div style="font-weight:700;color:var(--navy);margin-bottom:0.3rem;">' + nom + '</div>' +
            '<div style="display:flex;gap:0.4rem;align-items:center;">' +
            '<label style="color:var(--text-muted);font-size:0.72rem;">Intensité:</label>' +
            '<select onchange="updateSymptomeDetail(\'' + nom.replace(/'/g,"\\'") + '\',\'intensite\',this.value)" style="padding:0.2rem;border:1px solid var(--border);border-radius:4px;font-size:0.75rem;font-family:inherit;">' +
            '<option value="0"' + (data.intensite==0?' selected':'') + '>0</option>' +
            '<option value="1"' + (data.intensite==1?' selected':'') + '>1</option>' +
            '<option value="2"' + (data.intensite==2?' selected':'') + '>2</option>' +
            '<option value="3"' + (data.intensite==3?' selected':'') + '>3</option>' +
            '<option value="4"' + (data.intensite==4?' selected':'') + '>4</option>' +
            '<option value="5"' + (data.intensite==5?' selected':'') + '>5</option>' +
            '</select>' +
            '<label style="color:var(--text-muted);font-size:0.72rem;margin-left:0.3rem;">Évol:</label>' +
            '<select onchange="updateSymptomeDetail(\'' + nom.replace(/'/g,"\\'") + '\',\'evolution\',this.value)" style="padding:0.2rem;border:1px solid var(--border);border-radius:4px;font-size:0.75rem;font-family:inherit;">' +
            '<option value="stable"' + (data.evolution=='stable'?' selected':'') + '>Stable</option>' +
            '<option value="aggravation"' + (data.evolution=='aggravation'?' selected':'') + '>Aggrav.</option>' +
            '<option value="amelioration"' + (data.evolution=='amelioration'?' selected':'') + '>Amélior.</option>' +
            '</select></div></div>';
    });
    c.innerHTML = html;
}
function updateSymptomeDetail(nom, field, value) {
    var data = selectedSymptomes.get(nom);
    if (data) { data[field] = field === 'intensite' ? parseInt(value) : value; }
}
function filterSymptomes(q) {
    var filtered = q ? SYMPTOMES.filter(function(s) { return s.toLowerCase().includes(q.toLowerCase()); }) : SYMPTOMES;
    renderSymptomes(filtered);
    var box = document.getElementById('add-symptome-box');
    box.style.display = (q && filtered.length === 0) ? 'block' : 'none';
    if (q && filtered.length === 0) document.getElementById('custom-symptome-input').value = q;
}
function ajouterSymptomeCustom() {
    var val = document.getElementById('custom-symptome-input').value.trim();
    if (!val) return;
    if (!SYMPTOMES.includes(val)) SYMPTOMES.push(val);
    selectedSymptomes.set(val, {intensite: 0, evolution: 'stable'});
    document.getElementById('symptome-search').value = '';
    document.getElementById('add-symptome-box').style.display = 'none';
    renderSymptomes(SYMPTOMES);
    document.getElementById('symptomes-count').textContent = selectedSymptomes.size + ' symptôme(s)';
    renderSymptomesDetails();
    updateAISuggestions();
}

